* text=auto eol=lf
*.ps1 text eol=crlf

# Preserve the exact bytes referenced by protocol evidence; SSE needs a blank terminator.
examples/deepseek/cases/*.json -text whitespace=cr-at-eol
examples/deepseek/review-fixes/*.sse -text whitespace=-blank-at-eof
# Preserve independent review inputs byte-for-byte, including their recorded SHA-256.
examples/capacity/review-fixes/*.input.json -text whitespace=cr-at-eol
examples/orchestration/*.json -text whitespace=cr-at-eol
# Failure tracebacks inside JUnit preserve original whitespace as execution evidence.
examples/orchestration/*.xml -text whitespace=-blank-at-eol,cr-at-eol
examples/orchestration/review-fixes/*.json -text whitespace=cr-at-eol
# Resource workbench observations and original review inputs retain their recorded bytes.
examples/resource-workbench/*.json -text whitespace=cr-at-eol
examples/resource-workbench/review-fixes/* -text whitespace=cr-at-eol
examples/resource-workbench/*.xml -text whitespace=-blank-at-eof,cr-at-eol
# Routing snapshots and review transcripts retain the bytes used by their hashes.
examples/routing/*.json -text whitespace=cr-at-eol
examples/routing/*.xml -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
examples/routing/review-fixes/*.json -text whitespace=cr-at-eol
examples/routing/review-fixes/*.xml -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
# Publication inputs, failure traces and review replays retain their captured bytes.
examples/rulebook-publication/*.json -text whitespace=cr-at-eol
examples/rulebook-publication/*.xml -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
examples/rulebook-publication/review-fixes/*.json -text whitespace=cr-at-eol
examples/rulebook-publication/review-fixes/*.xml -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
# Routing workbench reports and original review inputs keep their captured bytes.
examples/routing-workbench/*.json -text whitespace=cr-at-eol
examples/routing-workbench/*.xml -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
examples/routing-workbench/review-fixes/*.json -text whitespace=cr-at-eol
examples/routing-workbench/review-fixes/*.xml -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
# Preserve capacity capture observations and actual test reports.
examples/capacity-facts/*.json -text whitespace=cr-at-eol
examples/capacity-facts/*.xml -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
