  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "karajan.probe.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "case_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Case Id",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/Profile"
    },
    "attempt": {
      "$ref": "#/$defs/AttemptManifest"
    },
    "required_capabilities": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Capabilities",
      "type": "array"
    },
    "events": {
      "items": {
        "discriminator": {
          "mapping": {
            "binding.accepted": "#/$defs/AcceptedBindingEvent",
            "binding.provider_reported": "#/$defs/ProviderBindingEvent",
            "capability.result": "#/$defs/CapabilityResultEvent"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/AcceptedBindingEvent"
          },
          {
            "$ref": "#/$defs/ProviderBindingEvent"
          },
          {
            "$ref": "#/$defs/CapabilityResultEvent"
          }
        ]
      },
      "title": "Events",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
