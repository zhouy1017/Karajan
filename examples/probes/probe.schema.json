          "title": "Event Id",
          "type": "string"
        },
        "attempt_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Attempt Id",
          "type": "string"
        },
        "fence": {
          "exclusiveMinimum": 0,
          "title": "Fence",
          "type": "integer"
        },
        "profile_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Profile Id",
          "type": "string"
        },
        "profile_revision": {
          "exclusiveMinimum": 0,
          "title": "Profile Revision",
          "type": "integer"
        },
        "type": {
          "const": "binding.accepted",
          "title": "Type",
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        }
      },
      "required": [
        "event_id",
        "attempt_id",
        "fence",
        "profile_id",
        "profile_revision",
        "type",
        "binding"
      ],
      "title": "AcceptedBindingEvent",
      "type": "object"
