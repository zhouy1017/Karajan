        "current_policy_revision": {
          "exclusiveMinimum": 0,
          "maximum": 1000000000,
          "title": "Current Policy Revision",
          "type": "integer"
        },
        "exhaustion_observation_required": {
          "title": "Exhaustion Observation Required",
          "type": "boolean"
