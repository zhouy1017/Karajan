          "maximum": 1000000000,
          "minimum": 0,
          "title": "Active Attempts",
          "type": "integer"
        },
        "cash_remaining": {
          "patternProperties": {
            "^[A-Z]{3}$": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            }
          },
          "title": "Cash Remaining",
          "type": "object"
        },
        "cooldown_until": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
